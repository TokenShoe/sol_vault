# =============================================================================
# cross_vault deploy config. Copy to .env and fill in:   cp .env.example .env
# .env is in .gitignore: NEVER commit it, it contains a private key.
# Guide: docs/deployment-guide.md
# Variables already set in the shell override this file. ENV_FILE=path picks another file
# (e.g. ENV_FILE=.env.mainnet yarn -s cli env-check).
# =============================================================================

# ---------- network ----------
# devnet:  https://devnet.helius-rpc.com/?api-key=YOUR_KEY   (free at https://dashboard.helius.dev; the public node is rate limited)
# mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.devnet.solana.com

# ---------- admin (deployer) ----------
# Private key exported from your browser wallet (Phantom / Solflare / Backpack): a long base58 string.
# A solana CLI key file content [12,34,...] also works.
# This wallet deploys the program (becomes the upgrade authority), initializes it and becomes admin.
# Needs SOL: ~7 SOL for the first deploy (about half is refunded right after), see `yarn -s cli env-check`.
ADMIN_PRIVATE_KEY=

# ---------- roles (address only, no private key) ----------
# operator: pays users (debit). rebalancer: bridges funds above the watermark (CCTP / Relay).
# Use separate wallets from admin. Both must hold some SOL for fees later (~0.2 SOL each).
OPERATOR_ADDRESS=
REBALANCER_ADDRESS=

# ---------- pools (one per token) ----------
# <TOKEN>_MINT        token mint; leave empty to skip that token
#                     mainnet USDC EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#                     mainnet USDT Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
#                     devnet  USDC 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU (Circle, faucet https://faucet.circle.com)
# <TOKEN>_WATERMARK   amount kept in the vault, in tokens (e.g. 1000 = 1000 USDC); only the part above it can be rebalanced. Required when MINT is set
# <TOKEN>_MAX_DEBIT   max amount per debit instruction, in tokens; empty or 0 = unlimited
USDC_MINT=
USDC_WATERMARK=
USDC_MAX_DEBIT=

USDT_MINT=
USDT_WATERMARK=
USDT_MAX_DEBIT=

# ---------- CCTP destination vaults (USDC only) ----------
# Our vault contract address (0x..., 40 hex chars) on each EVM chain. rebalance_cctp can ONLY send to these.
# Leave empty to skip a chain. Domain numbers are fixed: ETHEREUM 0, AVALANCHE 1, OPTIMISM 2, ARBITRUM 3, BASE 6, POLYGON 7
# On devnet use the testnet chains (Ethereum Sepolia, Base Sepolia, ...) with the same variable names.
CCTP_ROUTE_ETHEREUM=
CCTP_ROUTE_AVALANCHE=
CCTP_ROUTE_OPTIMISM=
CCTP_ROUTE_ARBITRUM=
CCTP_ROUTE_BASE=
CCTP_ROUTE_POLYGON=
