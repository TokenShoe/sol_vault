# =============================================================================
# cross_vault SECRETS. Copy to .env and fill in:   cp .env.example .env
# .env is in .gitignore: NEVER commit it. Back it up somewhere safe: losing it loses the wallets.
# Non-secret settings (pools, CCTP routes / domains, Relay, EVM testnet) live in config.json.
# Guide: docs/deployment-guide.md
# Shell variables override this file. ENV_FILE=path picks another file (e.g. ENV_FILE=.env.mainnet).
# =============================================================================

# ---------- network ----------
# Default network when a command has no --network flag: devnet / mainnet / localnet.
#   yarn -s cli deploy --network mainnet     <- picks the mainnet RPC, MAINNET_ keys and config.json networks.mainnet
# Every transaction is refused if the RPC turns out to be a different network.
NETWORK=devnet
# RPC per network (empty = networks.<network>.rpc in config.json, i.e. the public node). Put URLs with API keys here, e.g.
#   https://devnet.helius-rpc.com/?api-key=YOUR_KEY / https://mainnet.helius-rpc.com/?api-key=YOUR_KEY  (free: https://dashboard.helius.dev)
DEVNET_RPC_URL=
MAINNET_RPC_URL=

# ---------- Solana wallets: base58 private keys ----------
# Phantom: Settings -> Manage Accounts -> account -> Show Private Key. Solflare / Backpack: Export / Show Private Key.
# A solana CLI key file content [12,34,...] also works. Paste the PRIVATE KEY (~88 chars), not the address (~44 chars).
# Test wallets: `yarn -s cli keygen` fills every empty line below with a new wallet (never overwrites).
# Only ADMIN is needed to deploy / configure. A role without a private key can be given as an address
# in config.json networks.<network>.addresses instead (e.g. operator / rebalancer whose keys stay with the backend).
#
# Names without prefix are used on devnet / localnet. A DEVNET_ / LOCALNET_ prefixed name overrides them.
# MAINNET: private keys are read ONLY from MAINNET_ names (see the bottom), so test wallets can never sign on mainnet.

# admin: deploys (upgrade authority), initializes, creates pools, registers CCTP routes, pauses. ~7 SOL for the first deploy
ADMIN_PRIVATE_KEY=
# operator: pays users (debit)
OPERATOR_PRIVATE_KEY=
# rebalancer: rebalances (rebalance-cctp / rebalance-relay / add-liquidity)
REBALANCER_PRIVATE_KEY=
# feepayer: platform gas sponsor for user deposits
FEEPAYER_PRIVATE_KEY=
# fee-wallet: receives the platform fee on payouts
FEE_WALLET_PRIVATE_KEY=
# test users (devnet): user deposits with 0 SOL; user2 receives payouts
USER_PRIVATE_KEY=
USER2_PRIVATE_KEY=

# ---------- other secrets ----------
# V2 encrypted deposits: x25519 secret key, base64 (yarn -s cli keygen creates one)
ENCRYPTION_SECRET_KEY=
# EVM test wallet (0x + 64 hex): CCTP test recipient on Sepolia, pays receiveMessage gas (yarn -s cli evm-keygen)
EVM_PRIVATE_KEY=
# Optional: Relay API key (higher rate limits), EVM testnet RPC override
RELAY_API_KEY=
EVM_RPC_URL=

# ---------- MAINNET wallets (only these are used with --network mainnet) ----------
# Usually only the admin is needed here; give operator / rebalancer / fee-wallet as addresses in
# config.json networks.mainnet.addresses. Use a fresh wallet; move admin to a multisig after launch.
MAINNET_ADMIN_PRIVATE_KEY=
